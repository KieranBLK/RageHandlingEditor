# clang-tidy checks for every script's C++ source, read by the language server and by /lint
# Only the allowlist runs. Dropped bugprone checks and why:
# easily-swappable-parameters and narrowing-conversions flag nearly every signature and cast in code that talks to game memory
# assignment-in-if-condition flags a deliberate parenthesized assignment compared to a value, and throwing-static-initialization flags any file-scope container
# signed-bitwise flags every Windows flag macro masked against an unsigned field
Checks: >-
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  -bugprone-assignment-in-if-condition,
  -bugprone-throwing-static-initialization,
  -bugprone-signed-bitwise,
  misc-unused-parameters,
  modernize-use-nullptr,
  performance-unnecessary-value-param,
  readability-misleading-indentation,
  readability-redundant-declaration,
  readability-identifier-naming
# Names follow the project's naming rules: PascalCase types and functions, camelCase variables and members, and upper case with underscores for constants
# A leading underscore fails every one of these cases
CheckOptions:
  readability-identifier-naming.FunctionCase: CamelCase
  readability-identifier-naming.ClassCase: CamelCase
  readability-identifier-naming.StructCase: CamelCase
  readability-identifier-naming.TypedefCase: CamelCase
  readability-identifier-naming.TypeAliasCase: CamelCase
  readability-identifier-naming.EnumCase: CamelCase
  readability-identifier-naming.VariableCase: camelBack
  readability-identifier-naming.ParameterCase: camelBack
  readability-identifier-naming.MemberCase: camelBack
  readability-identifier-naming.LocalConstantCase: camelBack
  readability-identifier-naming.GlobalConstantCase: UPPER_CASE
  readability-identifier-naming.StaticConstantCase: UPPER_CASE
  readability-identifier-naming.ConstexprVariableCase: UPPER_CASE
