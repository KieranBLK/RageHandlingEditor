<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>RageHandlingEditor</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- The folder holding ScriptHookVDotNet3.dll and LemonUI.SHVDN3.dll, overridable with -p:ReferenceDir=<folder>\ -->
    <ReferenceDir Condition="'$(ReferenceDir)' == ''">C:\Temp\</ReferenceDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Src\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="ScriptHookVDotNet3">
      <HintPath>$(ReferenceDir)ScriptHookVDotNet3.dll</HintPath>
    </Reference>
    <Reference Include="LemonUI.SHVDN3">
      <HintPath>$(ReferenceDir)LemonUI.SHVDN3.dll</HintPath>
    </Reference>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

</Project>
