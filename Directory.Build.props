<Project>
  <!-- Analyzer and language settings for every script's C# project. C++ projects import this file too, so each part applies to a .csproj only -->
  <!-- LangVersion matches the compiler the build ships with, so the language server flags any newer feature that compiler would reject -->
  <PropertyGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
    <LangVersion>5</LangVersion>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- IDE0005 (unused using) reports in a build only with documentation generation on, and the missing comment warning it brings stays off -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- Each script declares its own assembly attributes in Core.cs, as the shipping build needs them -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <!-- The shipping build compiles with csc.exe's default reference list plus Microsoft.VisualBasic, so the projects reference the ones the scripts use -->
  <ItemGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
    <Reference Include="System.Web.Extensions" />
    <Reference Include="Microsoft.VisualBasic" />
  </ItemGroup>
  <ItemGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
    <PackageReference Include="StyleCop.Analyzers" Version="1.3.151-beta" PrivateAssets="all" />
    <PackageReference Include="Roslynator.Analyzers" Version="5.0.1" PrivateAssets="all" />
    <PackageReference Include="Roslynator.Formatting.Analyzers" Version="5.0.1" PrivateAssets="all" />
  </ItemGroup>
</Project>
